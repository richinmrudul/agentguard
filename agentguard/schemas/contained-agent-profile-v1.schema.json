{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://richinmrudul.github.io/agentguard/schemas/contained-agent-profile-v1.schema.json",
  "title": "AgentGuard contained agent profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "id", "display_label", "image", "argv"],
  "properties": {
    "schema": {"const": "agentguard.contained-agent-profile"},
    "schema_version": {"const": 1},
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "display_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "image": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "@sha256:[0-9A-Fa-f]{64}$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"type": "string", "minLength": 1, "maxLength": 2048}
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {"$ref": "#/$defs/environmentNames"},
        "unset": {"$ref": "#/$defs/environmentNames"}
      },
      "default": {}
    },
    "network": {
      "type": "string",
      "enum": ["none", "bridge"],
      "default": "none"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "cpu_limit": {"type": "number", "minimum": 0.1, "maximum": 8.0},
        "memory_limit": {"type": "string", "pattern": "^[1-9][0-9]*[kKmMgG]?$"},
        "pids_limit": {"type": "integer", "minimum": 16, "maximum": 4096},
        "max_output_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 52428800
        }
      },
      "default": {}
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
      },
      "default": []
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent_name": {"type": "string", "minLength": 1, "maxLength": 2048},
        "agent_version": {"type": "string", "minLength": 1, "maxLength": 2048},
        "evidence_source": {
          "type": "string",
          "enum": ["profile-declared", "image-digest"],
          "default": "profile-declared"
        }
      },
      "default": {}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_cost_usd": {"type": "number", "minimum": 0, "maximum": 1000},
        "max_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        }
      },
      "default": {}
    }
  },
  "$defs": {
    "environmentNames": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Z_][A-Z0-9_]*$"
      },
      "default": []
    }
  }
}
