diff --git a/codex-rs/models-manager/src/manager_tests.rs b/codex-rs/models-manager/src/manager_tests.rs
index 4ef2971..4606ff2 100644
--- a/codex-rs/models-manager/src/manager_tests.rs
+++ b/codex-rs/models-manager/src/manager_tests.rs
@@ -769,0 +770,62 @@ async fn get_model_info_tracks_fallback_usage() {
+#[tokio::test]
+async fn dated_gpt_5_2_snapshot_has_exact_bundled_metadata() {
+    let codex_home = tempdir().expect("temp dir");
+    let manager = openai_manager_for_tests(
+        codex_home.path().to_path_buf(),
+        TestModelsEndpoint::new(Vec::new()),
+    );
+    let config = ModelsManagerConfig::default();
+    let slug = "gpt-5.2-2025-12-11";
+
+    let exact = manager.get_model_info(slug, &config).await;
+    assert!(!exact.used_fallback_model_metadata);
+    assert_eq!(exact.slug, slug);
+    assert_eq!(exact.context_window, Some(128_000));
+    assert_eq!(exact.max_context_window, Some(128_000));
+    assert_eq!(exact.auto_compact_token_limit(), Some(100_000));
+    assert_eq!(
+        exact.default_reasoning_level.as_ref().map(|v| v.as_str()),
+        Some("none")
+    );
+    assert_eq!(
+        exact
+            .supported_reasoning_levels
+            .iter()
+            .map(|level| level.effort.as_str())
+            .collect::<Vec<_>>(),
+        ["none", "low", "medium", "high", "xhigh"]
+    );
+    assert!(!exact.supports_reasoning_summary_parameter);
+    assert!(!exact.support_verbosity);
+    assert!(!exact.use_responses_lite);
+    assert_eq!(
+        exact.apply_patch_tool_type,
+        Some(codex_protocol::openai_models::ApplyPatchToolType::Freeform)
+    );
+    assert!(exact
+        .model_messages
+        .as_ref()
+        .and_then(|messages| messages.instructions_template.as_ref())
+        .is_some_and(|instructions| !instructions.is_empty()));
+
+    let suffixed = manager
+        .get_model_info("gpt-5.2-2025-12-11-unreviewed", &config)
+        .await;
+    assert!(suffixed.used_fallback_model_metadata);
+    let namespaced = manager
+        .get_model_info("unreviewed/gpt-5.2-2025-12-11", &config)
+        .await;
+    assert!(namespaced.used_fallback_model_metadata);
+
+    let no_snapshot = manager
+        .get_remote_models()
+        .await
+        .into_iter()
+        .filter(|candidate| candidate.slug != slug)
+        .collect::<Vec<_>>();
+    assert!(std::panic::catch_unwind(|| {
+        construct_model_info_from_candidates(slug, &no_snapshot, &config)
+    })
+    .is_err());
+}
+
