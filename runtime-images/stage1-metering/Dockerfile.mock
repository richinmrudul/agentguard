# syntax=docker/dockerfile:1.7
FROM --platform=linux/amd64 gcr.io/distroless/python3-debian13:nonroot@sha256:ab7db4566f1d345612bcd57e1d33d8beb428d111f477dac98521a98fa4ab754d

LABEL org.opencontainers.image.title="AgentGuard Stage 1 mock Responses provider"
LABEL org.opencontainers.image.licenses="MIT"
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /
COPY --chmod=0555 runtime-images/stage1-metering/mock_responses_provider.py /stage1-mock-responses-provider
USER 65532:65532
EXPOSE 8443
ENTRYPOINT ["/usr/bin/python3", "/stage1-mock-responses-provider"]
