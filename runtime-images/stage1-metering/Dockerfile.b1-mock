# syntax=docker/dockerfile:1.7
FROM --platform=linux/amd64 gcr.io/distroless/python3-debian13:nonroot@sha256:ab7db4566f1d345612bcd57e1d33d8beb428d111f477dac98521a98fa4ab754d

LABEL org.opencontainers.image.title="AgentGuard Stage 1 B1 mock-only metering proof"
LABEL org.opencontainers.image.licenses="MIT"
ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /
COPY --chmod=0444 agentguard/__init__.py /app/agentguard/__init__.py
COPY --chmod=0444 agentguard/evaluation/__init__.py /app/agentguard/evaluation/__init__.py
COPY --chmod=0444 agentguard/evaluation/stage1_metering.py /app/agentguard/evaluation/stage1_metering.py
COPY --chmod=0444 agentguard/evaluation/stage1_metering_gateway.py /app/agentguard/evaluation/stage1_metering_gateway.py
COPY --chmod=0444 agentguard/evaluation/stage1_live_pricing.py /app/agentguard/evaluation/stage1_live_pricing.py
COPY --chmod=0444 agentguard/evaluation/stage1_pricing_v2.json /app/agentguard/evaluation/stage1_pricing_v2.json
COPY --chmod=0444 agentguard/evaluation/stage1_live_session.py /app/agentguard/evaluation/stage1_live_session.py
COPY --chmod=0444 agentguard/evaluation/stage1_live_transport.py /app/agentguard/evaluation/stage1_live_transport.py
COPY --chmod=0444 agentguard/evaluation/stage1_study_ledger.py /app/agentguard/evaluation/stage1_study_ledger.py
COPY --chmod=0555 runtime-images/stage1-metering/b1_mock_gateway.py /stage1-b1-mock-gateway
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/bin/python3", "/stage1-b1-mock-gateway"]
